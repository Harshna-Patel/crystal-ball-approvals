{
  "name": "crystal-ball",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"node --import tsx server/index.ts\" \"next dev --hostname 127.0.0.1\"",
    "build": "next build",
    "start": "concurrently -k \"node --import tsx server/index.ts\" \"next start --hostname 127.0.0.1\"",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "jest --runInBand",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:ai": "node --import tsx server/check-ai.ts",
    "format": "prettier --write app components data lib prompts server shared test *.json *.ts *.mjs *.cjs",
    "format:check": "prettier --check app components data lib prompts server shared test *.json *.ts *.mjs *.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "next": "^15.5.28",
    "openai": "^4.104.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  }
}
